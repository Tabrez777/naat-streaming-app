rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔓 Allow users to create profiles when logging in
    match /users/{userId} {
      allow read, write: if true; 
    }

    // 🔒 Keep all your music safe and readable by everyone
    match /{document=**} {
      allow read: if true;
    }
  }
}