rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔓 Allow users to create and edit their own profiles/playlists
    match /users/{userId} {
      allow read, write: if true; 
    }

    // 🔒 Keep music safe: Everyone can read, but only YOU can upload/delete!
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'mdtaffique@gmail.com';
    }
  }
}